# Add these with `npx supabase secrets set --project-ref YOUR_PROJECT_REF`
# Use a restricted Stripe key (rk_test_... / rk_live_...) with only the
# Customers, Checkout Sessions, Prices, Billing Portal Sessions, and
# Subscriptions permissions needed by the DOIT AI Edge Functions.
STRIPE_SECRET_KEY=rk_test_your_restricted_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
STRIPE_MONTHLY_PRICE_ID=price_your_monthly_price_id
STRIPE_ANNUAL_PRICE_ID=price_your_annual_price_id
STRIPE_MAX_MONTHLY_PRICE_ID=price_your_max_monthly_price_id
STRIPE_MAX_ANNUAL_PRICE_ID=price_your_max_annual_price_id
APP_URL=https://doit-ai.pages.dev

# Keep this server-side. Never put it in an EXPO_PUBLIC_ variable.
OPENAI_API_KEY=sk-proj_your_openai_api_key
OPENAI_GOAL_MODEL=gpt-5.6-luna
